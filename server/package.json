{
  "name": "live-board-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:ping": "node --env-file=.env src/db/ping.ts",
    "db:migrate": "node --env-file=.env src/db/migrate.ts",
    "test:db": "node --env-file=.env --test src/store/pg-store.integration.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1"
  }
}
